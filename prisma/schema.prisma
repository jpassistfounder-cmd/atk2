// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Market {
  id        String   @id @default(cuid())
  symbol    String   @unique
  baseAsset String
  quoteAsset String
  minPrice  Float
  maxPrice  Float
  pricePrecision Int
  quantityPrecision Int
  minNotional Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  candles Candle[]
  positions Position[]
  orders Order[]
  signals Signal[]
}

model Candle {
  id        String   @id @default(cuid())
  symbol    String
  market    Market   @relation(fields: [symbol], references: [symbol], onDelete: Cascade)
  timeframe String   // 1m, 5m, 15m, 1h, 4h, 1d
  openTime  DateTime
  closeTime DateTime
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float
  quoteVolume Float
  trades    Int
  takerBuyVolume Float
  takerBuyQuoteVolume Float
  createdAt DateTime @default(now())

  @@unique([symbol, timeframe, openTime])
  @@index([symbol, timeframe, closeTime])
}

model PaperAccount {
  id        String   @id @default(cuid())
  name      String   @unique
  balance   Float    @default(10000)
  usedMargin Float   @default(0)
  availableMargin Float @default(10000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  positions Position[]
  orders    Order[]
  fills     Fill[]
  outcomes  Outcome[]
}

model Position {
  id        String   @id @default(cuid())
  symbol    String
  market    Market   @relation(fields: [symbol], references: [symbol], onDelete: Restrict)
  account   PaperAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId String
  side      String   // LONG or SHORT
  quantity  Float
  entryPrice Float
  currentPrice Float
  leverage  Int      @default(1)
  marginUsed Float
  unrealizedPnL Float @default(0)
  status    String   @default("OPEN") // OPEN, CLOSING, CLOSED
  openedAt  DateTime @default(now())
  closedAt  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]
  exits  Exit[]
  
  @@unique([symbol, accountId, status])
  @@index([accountId, status])
}

model Order {
  id        String   @id @default(cuid())
  symbol    String
  market    Market   @relation(fields: [symbol], references: [symbol], onDelete: Restrict)
  account   PaperAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId String
  position  Position? @relation(fields: [positionId], references: [id], onDelete: Set Null)
  positionId String?
  side      String   // BUY or SELL
  quantity  Float
  price     Float
  orderType String   @default("LIMIT") // LIMIT, MARKET, STOP_LOSS, TAKE_PROFIT
  status    String   @default("PENDING") // PENDING, FILLED, CANCELLED, REJECTED
  filledQuantity Float @default(0)
  filledPrice Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  filledAt  DateTime?

  fills Fill[]
  
  @@index([accountId, status])
  @@index([symbol, status])
}

model Fill {
  id        String   @id @default(cuid())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  account   PaperAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId String
  quantity  Float
  price     Float
  commission Float
  timestamp DateTime @default(now())

  @@index([accountId, timestamp])
}

model Exit {
  id        String   @id @default(cuid())
  position  Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
  positionId String
  reason    String   // TAKE_PROFIT, STOP_LOSS, MANUAL, LIQUIDATION
  exitPrice Float
  exitQuantity Float
  timestamp DateTime @default(now())

  @@index([positionId, timestamp])
}

model Signal {
  id        String   @id @default(cuid())
  symbol    String
  market    Market   @relation(fields: [symbol], references: [symbol], onDelete: Cascade)
  engine    String   // STRUCTURE, VOLUME, MOMENTUM, DERIVATIVES, LIQUIDITY
  side      String   // LONG or SHORT
  strength  Float    // 0-1
  confidence Float   // 0-1
  timestamp DateTime @default(now())

  traces   SignalTrace[]
  
  @@index([symbol, timestamp])
  @@index([engine, timestamp])
}

model SignalTrace {
  id        String   @id @default(cuid())
  signal    Signal   @relation(fields: [signalId], references: [id], onDelete: Cascade)
  signalId  String
  data      Json
  createdAt DateTime @default(now())
}

model DecisionTrace {
  id        String   @id @default(cuid())
  symbol    String
  timestamp DateTime @default(now())
  signals   Json
  decision  String   // ENTER_LONG, ENTER_SHORT, EXIT, HOLD
  confidence Float
  reasoning Json
  createdAt DateTime @default(now())

  @@index([symbol, timestamp])
}

model Outcome {
  id        String   @id @default(cuid())
  account   PaperAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId String
  symbol    String
  side      String   // LONG or SHORT
  entry     Float
  exit      Float
  quantity  Float
  pnl       Float
  pnlPercent Float
  duration  Int      // in seconds
  timestamp DateTime @default(now())

  @@index([accountId, timestamp])
}

model Learning {
  id        String   @id @default(cuid())
  symbol    String
  pattern   String
  frequency Int
  winRate   Float
  avgWin    Float
  avgLoss   Float
  profitFactor Float
  lastUpdated DateTime @updatedAt

  @@unique([symbol, pattern])
}